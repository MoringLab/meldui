{
  "name": "engine-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @engine/playground build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check packages apps/playground apps/server scripts tests",
    "format": "biome check --write packages apps/playground apps/server scripts tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schemas": "tsx scripts/export-schemas.ts",
    "fixtures": "tsx scripts/create-fixtures.ts",
    "dev": "pnpm --parallel --filter @engine/server --filter @engine/playground dev",
    "eval": "tsx scripts/evaluate.ts",
    "eval:online": "tsx scripts/evaluate-online.ts",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.58.2",
    "@axe-core/playwright": "4.11.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@changesets/cli": "2.29.8",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
